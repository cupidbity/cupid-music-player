{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cupid Player",
  "version": "0.0.0",
  "identifier": "com.cupidbity.cupid-player",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run vite",
    "beforeBuildCommand": "npx vite build"
  },
  "app": {
    "windows": [
      {
        "title": "Cupid Player",
        "width": 415,
        "height": 674,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../audio": "audio",
      "../assets": "assets"
    },
    "externalBin": ["binaries/yt-dlp"],
    "category": "Music",
    "macOS": {
      "minimumSystemVersion": "10.13"
    },
    "windows": {
      "nsis": {}
    },
    "linux": {
      "appimage": {}
    }
  },
  "plugins": {
    "deep-link": {
      "protocols": [
        {
          "schemes": ["cupid"],
          "name": "Cupid"
        }
      ]
    }
  }
}
